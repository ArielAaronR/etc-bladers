---
import Logo3D from '../components/Logo3D.astro';
import { site } from '../config';
import { asset } from '../lib/asset';
import '../styles/global.css';

const pacific = (options: Intl.DateTimeFormatOptions) => (iso: string) =>
  new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', ...options }).format(new Date(iso));
const dayName = pacific({ weekday: 'short' });
const monthDay = pacific({ month: 'short', day: 'numeric' });
const time = (iso: string) => pacific({ hour: 'numeric', minute: '2-digit' })(iso).replace(':00', '');

// Display strings for each event, also handed to the browser so it can drop past events.
const events = site.events.map((e) => ({
  url: e.url,
  place: e.place,
  // "ETC Blader Nights *Halloween Candy Bash*" → "ETC Blader Nights: Halloween Candy Bash"
  name: e.title.replace(/\s*\*(.+?)\*\s*/, ': $1').replace(/\*/g, '').trim(),
  when: `${dayName(e.start)}, ${monthDay(e.start)}, ${time(e.start)}`,
  day: dayName(e.start),
  date: monthDay(e.start),
  time: time(e.start),
  // Treat an event as over five hours after it starts.
  ends: new Date(e.start).getTime() + 5 * 3600 * 1000,
}));
const featured = events[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020b12" />
    <title>{site.name}</title>
    <meta name="description" content={`${site.name}: a Beyblade crew. Next event, Instagram and TikTok.`} />
    <meta property="og:title" content={site.name} />
    <meta property="og:image" content={Astro.site ? new URL(asset('logo.png'), Astro.site).href : asset('logo.png')} />
    <link rel="icon" type="image/png" href={asset('logo.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500&family=Michroma&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <div class="backdrop__floor"></div>
    </div>
    <canvas class="chrome" aria-hidden="true"></canvas>

    <div class="lander">
      <nav class="nav" aria-label="Main">
        <span class="nav__mark">ETC Bladers</span>
        <ul class="nav__links">
          <li><a class="link" href={site.socials.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a class="link" href={site.socials.tiktok} target="_blank" rel="noopener">TikTok</a></li>
        </ul>
      </nav>

      <main class="stage">
        <h1 class="sr-only">ETC Bladers</h1>
        <div class="stage__logo">
          <Logo3D />
        </div>

        <div class="stage__action" data-load style="--d:500ms">
          {
            featured && (
              <div class="stage__event" data-featured>
                <h2 class="stage__event-name" data-name>{featured.name}</h2>
                <p class="stage__event-when">
                  <span data-when>{featured.when}</span>
                  <span class="stage__event-sep"> · </span>
                  <span data-place>{featured.place}</span>
                </p>
              </div>
            )
          }
          <a
            class="button button--chrome"
            href={featured ? featured.url : site.eventsUrl}
            target="_blank"
            rel="noopener"
            data-featured-link
          >
            <span>
              {featured ? (
                <>
                  Register<span class="wide-only"> on West Coast Bladers</span>
                </>
              ) : (
                'See upcoming events'
              )}
            </span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
          </a>
          {events.length > 1 && (
            <a class="stage__more link" href="#coming-up" data-more>
              {events.length} ETC events coming up ↓
            </a>
          )}
        </div>
      </main>
    </div>

    {
      events.length > 1 && (
        <section class="crawl" id="coming-up" aria-labelledby="coming-up-title" data-crawl>
          <h2 class="crawl__title" id="coming-up-title">Coming up</h2>
          <ol class="crawl__list">
            {events.map((e) => (
              <li class="crawl__item" data-ends={e.ends}>
                <a class="crawl__row" href={e.url} target="_blank" rel="noopener">
                  <span class="crawl__date">
                    <span class="crawl__day">{e.day}</span>
                    <span class="crawl__md">{e.date}</span>
                  </span>
                  <span class="crawl__what">
                    <span class="crawl__name">{e.name}</span>
                    <span class="crawl__meta">
                      {e.time} · {e.place}
                    </span>
                  </span>
                  <span class="crawl__go">
                    Register
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <a class="crawl__all link" href={site.eventsUrl} target="_blank" rel="noopener">
            All events on West Coast Bladers ↗
          </a>
        </section>
      )
    }

    <script is:inline define:vars={{ events, eventsUrl: site.eventsUrl }}>
      // The page is built once a day; drop events that have ended since, and feature the
      // next one still to come.
      const now = Date.now();
      const upcoming = events.filter((e) => e.ends > now);
      const next = upcoming[0];
      const featured = document.querySelector('[data-featured]');
      const link = document.querySelector('[data-featured-link]');
      if (!next) {
        featured?.remove();
        link.href = eventsUrl;
        link.querySelector('span').textContent = 'See upcoming events';
      } else if (featured && next.url !== link.href) {
        featured.querySelector('[data-name]').textContent = next.name;
        featured.querySelector('[data-when]').textContent = next.when;
        featured.querySelector('[data-place]').textContent = next.place;
        link.href = next.url;
      }
      document.querySelectorAll('[data-ends]').forEach((li) => {
        if (Number(li.dataset.ends) <= now) li.remove();
      });
      if (upcoming.length < 2) {
        document.querySelector('[data-crawl]')?.remove();
        document.querySelector('[data-more]')?.remove();
      } else {
        const more = document.querySelector('[data-more]');
        if (more) more.textContent = upcoming.length + ' ETC events coming up ↓';
      }
    </script>
    <script>
      import { gsap } from 'gsap';
      import { ScrollToPlugin } from 'gsap/ScrollToPlugin';
      import { startChrome } from '../scripts/chrome';

      startChrome(
        document.querySelector<HTMLCanvasElement>('canvas.chrome')!,
        document.querySelector<HTMLElement>('[data-logo-anchor]')!,
        document.querySelector<HTMLButtonElement>('[data-logo-anchor]')!,
        document.getElementById('logo-readout')!,
        document.querySelector<HTMLElement>('[data-crawl]')
      );

      // "N events coming up" glides down to the list instead of jumping, so the logo
      // visibly recedes on the way. A wheel or touch mid-way hands control back.
      gsap.registerPlugin(ScrollToPlugin);
      const more = document.querySelector<HTMLAnchorElement>('[data-more]');
      const crawl = document.querySelector<HTMLElement>('[data-crawl]');
      more?.addEventListener('click', (event) => {
        if (!crawl || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        event.preventDefault();
        const title = crawl.querySelector<HTMLElement>('.crawl__title')!;
        gsap.to(window, {
          duration: 1.6,
          ease: 'power3.inOut',
          scrollTo: { y: crawl, autoKill: true },
          onComplete: () => {
            title.tabIndex = -1;
            title.focus({ preventScroll: true });
            history.replaceState(null, '', '#coming-up');
          },
        });
      });
    </script>
  </body>
</html>

<style>
  /* Deep violet space with a glowing horizon and a chrome-poster grid floor. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 38% at 50% 100%, #2fe0c8 0%, #0e9fd8 26%, rgba(6, 70, 110, 0.6) 55%, transparent 80%),
      radial-gradient(ellipse 60% 50% at 50% 30%, rgba(6, 60, 90, 0.5), transparent 70%),
      var(--ground);
  }
  .backdrop__floor {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: -10%;
    height: 70%;
    background-image:
      linear-gradient(rgba(170, 250, 240, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(170, 250, 240, 0.5) 1px, transparent 1px);
    background-size: 72px 72px;
    transform: perspective(600px) rotateX(60deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000 30%, transparent 95%);
    mask-image: linear-gradient(to top, #000 30%, transparent 95%);
  }
  .chrome {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .lander {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr);
    padding: 24px var(--margin) 40px;
  }
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav__mark {
    font-family: var(--display);
    font-size: var(--step-small);
  }
  .nav__links {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: inline-block;
    padding: 10px 0;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-content: center;
    gap: 28px;
  }
  .stage__logo {
    /* The last term leaves room for the orbit ring on a phone (see chrome.ts). */
    width: min(100%, 640px, 72vh, calc((100vw - 32px) / 1.41));
  }
  /* Room for the orbit ring, which dips below the logo. */
  .stage__logo :global(.logo3d) {
    gap: min(12vw, 64px, 7vh);
  }

  .stage__action {
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }
  .stage__event {
    display: grid;
    gap: 6px;
  }
  .stage__event-name {
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    max-width: 22em;
  }
  .stage__event-when {
    color: var(--ink-soft);
  }
  @media (max-width: 599px) {
    .stage__event-when span:not(.stage__event-sep) {
      display: block;
    }
    .stage__event-sep,
    .wide-only {
      display: none;
    }
  }

  /* A pill of polished metal: banded highlights that slide on hover. */
  .button--chrome {
    gap: 10px;
    min-height: 56px;
    padding: 0 32px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: linear-gradient(
        180deg,
        #ffffff 0%,
        #e2fbf6 30%,
        #7fd8e0 48%,
        #1d93bf 52%,
        #bff5ec 74%,
        #ffffff 100%
      )
      0 0 / 100% 200%;
    color: #032230;
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 -2px 6px rgba(10, 120, 170, 0.35),
      0 0 28px rgba(47, 224, 200, 0.45);
    transition:
      transform var(--t-press) var(--ease-out),
      background-position 400ms var(--ease-out);
  }
  .button--chrome svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform var(--t-hover) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .button--chrome:hover {
      background-color: transparent;
      background-position: 0 100%;
    }
    .button--chrome:hover svg {
      transform: translate(2px, -2px);
    }
  }

  .stage__more {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }

  /* Coming up: rows rise from the horizon tilted back, crawl-style, and straighten as
     they reach the middle of the screen so they read and tap normally. */
  .crawl {
    display: grid;
    justify-items: center;
    gap: 32px;
    padding: 18vh var(--margin) 28vh;
    perspective: 900px;
  }
  .crawl__title {
    font-size: clamp(28px, 4vw, 48px);
  }
  .crawl__list {
    display: grid;
    gap: 16px;
    width: min(100%, 760px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crawl__row {
    display: grid;
    grid-template-columns: 4.8em 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    padding: 20px clamp(18px, 3vw, 28px);
    border: 1px solid rgba(160, 245, 235, 0.22);
    border-radius: 24px;
    background: rgba(2, 18, 28, 0.62);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    text-decoration: none;
    transition:
      border-color var(--t-hover) ease,
      transform var(--t-press) var(--ease-out);
  }
  .crawl__row:active {
    transform: scale(0.98);
  }
  .crawl__date {
    display: grid;
    justify-items: center;
    font-family: var(--display);
    line-height: 1.1;
  }
  .crawl__day {
    font-size: var(--step-small);
    color: #5ff0d6;
  }
  .crawl__md {
    font-size: clamp(18px, 2vw, 22px);
    white-space: nowrap;
  }
  .crawl__what {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .crawl__name {
    font-family: var(--display);
    font-size: clamp(15px, 1.7vw, 19px);
    line-height: 1.3;
  }
  .crawl__meta {
    color: var(--ink-soft);
  }
  .crawl__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step-small);
    white-space: nowrap;
  }
  .crawl__go svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform var(--t-hover) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .crawl__row:hover {
      border-color: rgba(160, 245, 235, 0.7);
    }
    .crawl__row:hover .crawl__go svg {
      transform: translate(2px, -2px);
    }
  }
  .crawl__all {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }
  @media (max-width: 599px) {
    .crawl__row {
      grid-template-columns: 4.8em 1fr;
    }
    .crawl__go {
      display: none;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .crawl__title,
      .crawl__item {
        transform-origin: 50% 100%;
        animation: crawl-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }
  @keyframes crawl-in {
    from {
      opacity: 0;
      transform: translateY(40px) rotateX(42deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
